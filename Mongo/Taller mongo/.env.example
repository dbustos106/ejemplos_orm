# Copie este archivo como ".env" y ajuste la cadena de conexión.

# Opción A: MongoDB local (Docker Compose)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/?authSource=admin

# Opción B: MongoDB Atlas (reemplace usuario, contraseña y cluster)
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=chat
